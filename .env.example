# Local development. Run python scripts/init_local.py to generate .env.
APP_NAME=Club events
APP_OWNER=Ayan Kassen
APP_VERSION=dev
APP_PORT=8000

# Filled by init_local.py. Keep the generated .env out of Git.
SECRET_KEY=
DB_PASSWORD=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

DB_URL='postgresql+psycopg://app_rw:${DB_PASSWORD}@postgres:5432/club_events'
STORAGE_BACKEND=local
BUCKET=/app/data/uploads
LOG_LEVEL=INFO
LOG_FORMAT=json
PASSWORD_MIN_LENGTH=14
PASSWORD_REQUIRE_SYMBOL=false
